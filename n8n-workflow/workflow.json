{
  "name": "AISCOP · HU-05 · Ticket urgente → correo",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aiscop-ticket-urgente",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "name": "Webhook ticket urgente",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "AISCOP webhook secreto"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "Mesa de Ayuda AISCOP <soporte@tu-dominio.com>",
        "toEmail": "equipo-soporte@tu-dominio.com",
        "subject": "=[AISCOP] Ticket urgente #{{ $json.body.ticket_id }}: {{ $json.body.titulo }}",
        "emailFormat": "html",
        "html": "=<h2 style='color:#b0081a'>Nuevo ticket urgente</h2><p><b>Ticket:</b> #{{ $json.body.ticket_id }}<br><b>Título:</b> {{ $json.body.titulo }}<br><b>Cliente:</b> {{ $json.body.cliente }}<br><b>Categoría:</b> {{ $json.body.categoria }}<br><b>Creado:</b> {{ $json.body.creado }}</p><p>{{ $json.body.descripcion }}</p><p><a href='{{ $json.body.url }}'>Abrir en la Mesa de Ayuda</a></p>",
        "options": {}
      },
      "name": "Correo al equipo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        260,
        0
      ],
      "credentials": {
        "smtp": {
          "name": "AISCOP SMTP Univalle"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a",
              "name": "enviado",
              "value": true,
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "name": "Respuesta",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        520,
        0
      ]
    }
  ],
  "connections": {
    "Webhook ticket urgente": {
      "main": [
        [
          {
            "node": "Correo al equipo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Correo al equipo": {
      "main": [
        [
          {
            "node": "Respuesta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
